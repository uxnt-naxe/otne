// HelloWorld.otne —— 你好，世界
// 运行：otne resources/code/HelloWorld.otne
// use stdio;
// use foo;

func describe(value: any): string {
    return type(value) + ": " + value;
}

func main()
{
    let count: int = 42;
    float ratio = 0.5;
    const name = "Otne";

    println ( "ratio:" + ratio * 5 + " " + describe(0.5) );
    println ( name + " " + "Hello!" );
}
